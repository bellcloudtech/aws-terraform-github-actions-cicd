# Terraform working directory
**/.terraform/*

# Terraform state files may contain sensitive information
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files may contain passwords or account details
*.tfvars
*.tfvars.json

# Allow safe example variable files
!*.tfvars.example

# Terraform plan files
*.tfplan
*.plan

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# AWS credentials
.aws/
credentials

# Local editor and operating-system files
.vscode/
.DS_Store
Thumbs.db

# Application dependencies and logs
node_modules/
__pycache__/
*.pyc
*.log